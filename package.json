{
  "name": "skein-monorepo",
  "private": true,
  "workspaces": [
    "web",
    "tests"
  ],
  "scripts": {
    "dev": "npm run build:wasm && npm run dev -w web",
    "build": "npm run build:wasm && npm run build -w web",
    "build:wasm": "wasm-pack build crates/skein-wasm --target web --out-dir ../../web/src/wasm-pkg --no-pack",
    "fixtures": "node bench/generate-fixtures.mjs",
    "logo": "node tools/logo.mjs",
    "test:e2e": "npm run test -w tests"
  }
}
